{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AetherTwin Studio",
  "version": "0.1.0",
  "identifier": "cn.aethertwin.studio",
  "build": {
    "frontendDist": "../../apps/studio/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AetherTwin Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
